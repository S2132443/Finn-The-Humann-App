# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=finn_db

# Application
SECRET_KEY=your-secret-key-change-in-production
BASE_CURRENCY=MYR
DEBUG=false

# CORS (comma-separated). Only matters when the SPA is served from a different
# origin than the API — i.e. during frontend dev (`npm run dev` on :3000).
# In production the SPA is served by FastAPI itself, so this is a no-op.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Exchange Rates (fallbacks; the app refreshes these via open.er-api.com)
USD_TO_MYR=4.47
SGD_TO_MYR=3.31
EUR_TO_MYR=4.85
GBP_TO_MYR=5.65

# LUNO API (optional — auto-imports crypto balances)
# Generate read-only API keys at: https://www.luno.com/wallet/security/api_keys
LUNO_API_KEY_ID=
LUNO_API_KEY_SECRET=
