# Railway Environment Variables Configuration
# Copy these variables to your Railway service settings

# ==========================================
# BACKEND SERVICE ENVIRONMENT VARIABLES
# ==========================================

# Database (automatically set by Railway PostgreSQL plugin)
# DATABASE_URL=postgresql://user:password@host:port/database

# Application Security
SECRET_KEY=generate-a-secure-random-key-here

# Application Settings
BASE_CURRENCY=MYR
DEBUG=false

# Port (automatically set by Railway)
# PORT=8000


# ==========================================
# FRONTEND SERVICE ENVIRONMENT VARIABLES
# ==========================================

# Backend API URL (set to your Railway backend service URL)
# Example: https://finn-backend-production.up.railway.app
API_BASE_URL=https://your-backend-service.up.railway.app

# Application Security (use same SECRET_KEY as backend)
SECRET_KEY=generate-a-secure-random-key-here

# Flask Settings
FLASK_ENV=production
DEBUG=false

# Port (automatically set by Railway)
# PORT=5000


# ==========================================
# HOW TO GENERATE SECRET_KEY
# ==========================================
# Run this command in your terminal:
# python -c "import secrets; print(secrets.token_urlsafe(32))"


# ==========================================
# EXCHANGE RATES (Manual configuration for MVP)
# ==========================================
# Future: Will be replaced with API integration
USD_TO_MYR=4.47
SGD_TO_MYR=3.31
EUR_TO_MYR=4.85
GBP_TO_MYR=5.65


# ==========================================
# DEPLOYMENT CHECKLIST
# ==========================================
# [ ] Create PostgreSQL database in Railway
# [ ] Deploy backend service with root directory set to "backend"
# [ ] Deploy frontend service with root directory set to "frontend"
# [ ] Set DATABASE_URL for backend (auto-set by Railway)
# [ ] Generate and set SECRET_KEY for both services
# [ ] Set API_BASE_URL in frontend to backend service URL
# [ ] Initialize database schema using database/init.sql
# [ ] Verify services are running and can communicate
